# =============================================================================
# Cameroon repo .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Caches, virtual environments, Claude Code files (repo-wide, any depth)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

.venv/
venv/
ENV/
env/
esptool-venv/

.claude/

# server credentials and deployment helpers: never commit
hosting/
**/csfuturecities.txt
**/*credentials*
**/*password*

.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Layout: code/ (one git repo per package/tool), reports/, bibliography/, data/
# -----------------------------------------------------------------------------

# Reports: only project_web (the public site) is tracked here. The other
# report folders stay local; AddressPaper is its OWN separate git repo (CI
# has no credentials to clone it).
**/reports/*
!reports/
!reports/project_web/
!reports/project_web/**
reports/AddressPaper/

# Video/photo dumps not tracked in git
data/trip_photos/

# code/: OSMAddressSystem is a submodule. The other code/* folders are their
# own nested git repos; they are not tracked by this repo until they have a
# remote and are registered with `git submodule add`.
code/IMURoadQuality/
code/proximity/
code/building_survey/
code/fotouni_town_qc/
code/gps/

# data/imu: raw phone IMU drives (Sensor Logger exports), large - not tracked
data/imu/**
!data/imu/README.md

# data/*/pilot_survey: raw RTK survey exports are not tracked - only the
# built douala.csv/fotouni.csv, survey_map.html, images/ and streets.gpkg.
**/pilot_survey/raw/

# data/douala/iuc and data/fotouni/town_survey: raw workshop files and phone-app
# exports (contain personal contact data) are not tracked, only READMEs.
data/douala/iuc/**
data/fotouni/town_survey/**
!data/*/*/README.md
!data/*/README.md
!data/fotouni/town_survey/*/
!data/fotouni/town_survey/*/README.md

# Cache directories
__pycache__/
cache/
**/cache/
**/__pycache__/

# Python bytecode
*.py[cod]
*$py.class

# Methodology writeup and paper PDFs stay local
data/building_datasets.md
bibliography/papers/*.pdf

# personal notes
todo.txt
