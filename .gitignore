# =============================================================================
# Cameroon repo .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Caches, virtual environments, Claude Code files (repo-wide, any depth)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

.venv/
venv/
ENV/
env/
esptool-venv/

.claude/

.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Reports
# -----------------------------------------------------------------------------

# Ignore reports folders everywhere
**/reports/*

# But keep root reports/project_web
!reports/
!reports/project_web/
!reports/project_web/**

# -----------------------------------------------------------------------------
# documents/: only project_web is tracked here; the FUAS report/
# presentation, MediaLabWeb, proposal_MIT, and trip folders stay local
# only. CameroonPaper is its OWN separate git repo (not a submodule of
# this one - CI has no credentials to clone it) - ignored entirely so
# this repo never tracks or references its contents.
# -----------------------------------------------------------------------------
documents/FUASPresentation/
documents/FUASProjektarbeit/
documents/MediaLabWeb/
documents/proposal_MIT/
documents/trip/
documents/CameroonPaper/

# -----------------------------------------------------------------------------
# Video/photo dumps not tracked in git
# -----------------------------------------------------------------------------
fotouintv/
data/trip_photos/

# -----------------------------------------------------------------------------
# data/car_cam: keep only the three CSV streams the IMU road-quality
# experiment actually loads per drive (Location.csv, Accelerometer.csv,
# Gravity.csv - see IMURoadQuality/src/imu_road_quality/io.py's
# REQUIRED_FILES). Everything else (Camera/ footage, DCIM, IMU-only extra
# streams, Gyroscope/Orientation/TotalAcceleration/Metadata/Annotation CSVs,
# etc.) is ignored.
# -----------------------------------------------------------------------------
data/car_cam/**
!data/car_cam/**/
!data/car_cam/**/Location.csv
!data/car_cam/**/Accelerometer.csv
!data/car_cam/**/Gravity.csv

# -----------------------------------------------------------------------------
# data/douala and data/fotouni: raw survey exports and the methodology
# writeup are not tracked - only the built douala.csv/fotouni.csv,
# survey_map.html, images/, and streets.gpkg are.
# -----------------------------------------------------------------------------
data/douala/raw/
data/fotouni/raw/
data/building_datasets.md

# -----------------------------------------------------------------------------
# gps: keep only Python source files and their dependency manifests
# (firmware binaries, the SNIP installer, the C++ ntrip client, and any
# build output/venvs are not tracked).
# -----------------------------------------------------------------------------
gps/*

# Keep the gps directory itself
!gps/

# Allow the specific scripts
!gps/check_rctm.py
!gps/rtk2go_and_fix_error.py
!gps/rtk2go.py

# -----------------------------------------------------------------------------
# IUC: not tracked at all (workshop rasters/shapefiles/spreadsheets)
# -----------------------------------------------------------------------------
IUC/

# -----------------------------------------------------------------------------
# survey: raw field survey data/exports, not tracked at all
# -----------------------------------------------------------------------------
survey/

# Cache directories
__pycache__/
cache/
**/cache/
**/__pycache__/

# Python bytecode
*.py[cod]
*$py.class

# Large sensor CSV exports (use Parquet instead)
data/car_cam/**/*.csv

**/raw/**
**/_raw/**
**/proximity/population/**
**/proximity/streets/**

*.osm