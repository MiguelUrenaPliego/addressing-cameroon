# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# -----------------------------------------------------------------------------
# Ignore everything under outputs
# -----------------------------------------------------------------------------
experiments/Cameroon/outputs/**

# Allow traversal
!experiments/Cameroon/outputs/

# Allow the five folders
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_09-32-13/
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_15-03-36/
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_15-15-53/
!experiments/Cameroon/outputs/Fotouni_Douala_26_03_2026__2026-03-26_08-44-46/
!experiments/Cameroon/outputs/Fotouni_Douala_26_03_2026__2026-03-26_13-16-53/

# Allow only HTML files in those folders
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_09-32-13/*.html
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_15-03-36/*.html
!experiments/Cameroon/outputs/Fotouni_25_03_2026__2026-03-25_15-15-53/*.html
!experiments/Cameroon/outputs/Fotouni_Douala_26_03_2026__2026-03-26_08-44-46/*.html
!experiments/Cameroon/outputs/Fotouni_Douala_26_03_2026__2026-03-26_13-16-53/*.html